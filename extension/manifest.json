{
  "manifest_version": 3,
  "name": "Klyro",
  "version": "0.1.0",
  "description": "Developer companion extension for inspecting active web pages and communicating with the Klyro testing backend.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Klyro"
  }
}
